{
    "$schema": "https://schema.tauri.app/config/2",
    "app": {
        "macOSPrivateApi": true,
        "security": {
            "csp": null
        },
        "windows": [
            {
                "decorations": false,
                "height": 960,
                "label": "main",
                "minHeight": 640,
                "minWidth": 960,
                "title": "Lore",
                "width": 1440
            },
            {
                "alwaysOnTop": true,
                "decorations": false,
                "height": 424,
                "label": "focus",
                "resizable": false,
                "shadow": false,
                "skipTaskbar": true,
                "title": "Focus",
                "transparent": true,
                "url": "focus.html",
                "visible": false,
                "width": 372
            },
            {
                "alwaysOnTop": true,
                "center": true,
                "decorations": false,
                "height": 580,
                "label": "capture",
                "resizable": false,
                "shadow": false,
                "skipTaskbar": true,
                "title": "Quick Capture",
                "transparent": true,
                "url": "capture.html",
                "visible": false,
                "width": 640
            }
        ]
    },
    "build": {
        "beforeBuildCommand": "pnpm build:sidecar && pnpm build",
        "beforeDevCommand": "pnpm dev:all",
        "devUrl": "http://localhost:1420",
        "frontendDist": "../dist"
    },
    "bundle": {
        "active": true,
        "externalBin": ["binaries/lore-sidecar"],
        "icon": [
            "icons/32x32.png",
            "icons/128x128.png",
            "icons/128x128@2x.png",
            "icons/icon.icns",
            "icons/icon.ico"
        ],
        "targets": "all"
    },
    "identifier": "com.lore.app",
    "productName": "Lore",
    "version": "1.0.0"
}
