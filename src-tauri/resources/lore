#!/bin/sh
# The `lore` command: hands folders and Markdown files to the Lore this script
# ships inside. It goes through `open`, so the app receives them the same way
# it does from Finder whether or not it is already running.

self="$0"
while [ -L "$self" ]; do
    target="$(readlink "$self")"
    case "$target" in
        /*) self="$target" ;;
        *) self="$(dirname "$self")/$target" ;;
    esac
done

# Lore.app/Contents/Resources/resources/lore
app="$(cd "$(dirname "$self")/../../.." && pwd)"

# `lore mcp [vault]` serves a vault to an agent over stdio. It runs the engine
# directly rather than through `open`, which would detach it from the pipe the
# agent is speaking on, and it works whether or not Lore itself is open.
if [ "$1" = "mcp" ]; then
    if [ -n "$2" ]; then
        if [ ! -d "$2" ]; then
            echo "$(basename "$0"): $2: not a folder" >&2
            exit 1
        fi
        vault="$(cd "$2" && pwd)"
    else
        identifier="$(/usr/libexec/PlistBuddy -c 'Print :CFBundleIdentifier' "$app/Contents/Info.plist")"
        vault="$HOME/Library/Application Support/$identifier/Vault"
    fi

    LORE_VAULT="$vault" exec "$app/Contents/MacOS/lore-sidecar" mcp
fi

if [ $# -eq 0 ]; then
    exec open -a "$app"
fi

for argument in "$@"; do
    if [ ! -e "$argument" ]; then
        echo "$(basename "$0"): $argument: no such file or directory" >&2
        exit 1
    fi
done

exec open -a "$app" "$@"
