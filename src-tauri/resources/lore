#!/bin/sh
# The `lore` command: hands folders and Markdown files to the Lore this script
# ships inside. It goes through `open`, so the app receives them the same way
# it does from Finder whether or not it is already running.

self="$0"
while [ -L "$self" ]; do
    target="$(readlink "$self")"
    case "$target" in
        /*) self="$target" ;;
        *) self="$(dirname "$self")/$target" ;;
    esac
done

# Lore.app/Contents/Resources/resources/lore
app="$(cd "$(dirname "$self")/../../.." && pwd)"

# Commands run in the engine, which prints their help and knows the vault. It is
# run directly rather than through `open`, which would detach `mcp` from the pipe
# the agent is speaking on, and it works whether or not Lore itself is open.
case "$1" in
    help | mcp | skills | doctor | -*)
        LORE_APP_ID="$(/usr/libexec/PlistBuddy -c 'Print :CFBundleIdentifier' "$app/Contents/Info.plist")" \
            exec "$app/Contents/MacOS/lore-sidecar" "$@"
        ;;
esac

if [ $# -eq 0 ]; then
    exec open -a "$app"
fi

for argument in "$@"; do
    if [ ! -e "$argument" ]; then
        echo "$(basename "$0"): $argument: no such file or directory" >&2
        echo "Run \`$(basename "$0") --help\` for usage." >&2
        exit 1
    fi
done

exec open -a "$app" "$@"
