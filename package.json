{
    "dependencies": {
        "@tauri-apps/api": "^2",
        "@tauri-apps/plugin-autostart": "^2.5.1",
        "@tauri-apps/plugin-dialog": "^2.7.3",
        "@tauri-apps/plugin-global-shortcut": "^2",
        "@tauri-apps/plugin-notification": "^2.4.0",
        "@tauri-apps/plugin-opener": "^2",
        "@tauri-apps/plugin-sql": "^2",
        "@tiptap/core": "^3.31.3",
        "@tiptap/extension-list": "^3.31.3",
        "@tiptap/extensions": "^3.31.3",
        "@tiptap/pm": "^3.31.3",
        "@tiptap/react": "^3.31.3",
        "@tiptap/starter-kit": "^3.31.3",
        "clsx": "^2.1.1",
        "mdast-util-gfm": "^3.1.0",
        "mdast-util-to-markdown": "^2.1.2",
        "react": "^19.1.0",
        "react-dom": "^19.1.0",
        "remark-gfm": "^4.0.1",
        "remark-parse": "^11.0.0",
        "tailwind-merge": "^3.6.0",
        "unified": "^11.0.5",
        "zustand": "^5.0.2"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@tailwindcss/vite": "^4.3.3",
        "@tauri-apps/cli": "^2",
        "@testing-library/dom": "^10.4.1",
        "@testing-library/react": "^16.3.3",
        "@types/mdast": "^4.0.4",
        "@types/react": "^19.1.8",
        "@types/react-dom": "^19.1.6",
        "@vitejs/plugin-react": "^4.6.0",
        "concurrently": "^9.1.0",
        "eslint": "^9.25.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-jsonc": "^3.1.2",
        "eslint-plugin-perfectionist": "^5.9.0",
        "eslint-plugin-prettier": "^5.5.5",
        "jsdom": "^30.0.1",
        "prettier": "^3.8.3",
        "prettier-plugin-sort-json": "^4.2.0",
        "prettier-plugin-tailwindcss": "^0.8.1",
        "tailwindcss": "^4.3.3",
        "typescript": "~5.8.3",
        "typescript-eslint": "^8.59.1",
        "vite": "^7.0.4",
        "vitest": "^3.0.5"
    },
    "name": "lore",
    "packageManager": "pnpm@11.17.0",
    "private": true,
    "scripts": {
        "build": "tsc && vite build",
        "build:sidecar": "pnpm --filter @lore/sidecar build",
        "dev": "vite",
        "dev:agent": "LORE_MODE=agent pnpm tauri dev",
        "dev:all": "concurrently -n vite,sidecar -c cyan,magenta \"pnpm dev\" \"pnpm dev:sidecar\"",
        "dev:sidecar": "pnpm --filter @lore/sidecar dev",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "preview": "vite preview",
        "tauri": "node scripts/tauri.mjs",
        "test": "vitest run && pnpm test:sidecar",
        "test:sidecar": "pnpm --filter @lore/sidecar test"
    },
    "type": "module",
    "version": "1.8.0"
}
