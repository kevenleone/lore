{
    "compilerOptions": {
        "allowImportingTsExtensions": true,
        "lib": ["ESNext"],
        "module": "ESNext",
        "moduleResolution": "bundler",
        "noEmit": true,
        "noFallthroughCasesInSwitch": true,

        "noUnusedLocals": true,
        "noUnusedParameters": true,
        /* Shared with the renderer by path rather than by package. `@lore/types` is
       type-only and erased at build; `@lore/derive` and `@lore/canvas` are real
       code, shared on purpose so a derived snippet and a sketch's body each have
       exactly one definition on both sides of the wire. */
        "paths": {
            "@lore/canvas": ["../src/lib/canvas-body.ts"],
            "@lore/derive": ["../src/data/derive.ts"],
            "@lore/types": ["../src/store/types.ts"]
        },
        "resolveJsonModule": true,
        "skipLibCheck": true,

        "strict": true,
        "target": "ESNext",
        "types": ["bun"],
        "verbatimModuleSyntax": true
    },
    "include": ["src", "test", "scripts"]
}
