{
    "compilerOptions": {
        "allowImportingTsExtensions": true,
        "lib": ["ESNext"],
        "module": "ESNext",
        "moduleResolution": "bundler",
        "noEmit": true,
        "noFallthroughCasesInSwitch": true,

        "noUnusedLocals": true,
        "noUnusedParameters": true,
        /* Shared with the renderer by path rather than by package. `@lore/types` is
       type-only and erased at build; `@lore/derive` is real code, shared on
       purpose so the rule "snippet is derived, never stored" has exactly one
       definition on both sides of the wire. */
        "paths": {
            "@lore/derive": ["../src/data/derive.ts"],
            "@lore/types": ["../src/store/types.ts"]
        },
        "skipLibCheck": true,

        "strict": true,
        "target": "ESNext",
        "types": ["bun"],
        "verbatimModuleSyntax": true
    },
    "include": ["src", "test", "scripts"]
}
